{
  "name": "job-tracker-e2e",
  "private": true,
  "description": "Playwright end-to-end tests for the Job Tracker, run against an isolated Docker stack.",
  "scripts": {
    "stack:up": "docker compose -p job-tracker-e2e --env-file .env.e2e -f ../docker-compose.yml up -d --build --wait",
    "stack:down": "docker compose -p job-tracker-e2e --env-file .env.e2e -f ../docker-compose.yml down -v",
    "stack:logs": "docker compose -p job-tracker-e2e --env-file .env.e2e -f ../docker-compose.yml logs --no-color",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "screenshots": "playwright test --config playwright.screenshots.config.ts",
    "format": "prettier --write . --ignore-path ../.prettierignore",
    "format:check": "prettier --check . --ignore-path ../.prettierignore",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "prettier": "3.9.10",
    "typescript": "~7.0.2"
  }
}
