# Settings for the isolated end-to-end stack (compose project "job-tracker-e2e").
# Used instead of the root .env, so the tests never see your real password or API key, and run on their own
# ports and database volume, separate from your everyday stack on 8080.
# This password only protects a throwaway test database on localhost; it is not a secret.
POSTGRES_USER=jobtracker
POSTGRES_PASSWORD=e2e-only-not-a-secret
POSTGRES_DB=jobtracker
WEB_PORT=8081
DB_PORT=5433
ANTHROPIC_API_KEY=
# Fill the fresh e2e database with the fictional demo data (screenshots, realistic e2e runs).
SEED_DEMO_DATA=true
